# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-for-form-builder-2026
JWT_EXPIRES_IN=7d

# Database Configuration
# Leave blank to use local zero-config SQLite store (data/forms.db)
# Or provide PostgreSQL / Supabase connection URL:
# DATABASE_URL=postgresql://postgres:[password]@db.[supabase-project].supabase.co:5432/postgres
DATABASE_URL=

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# File Upload Limit (MB)
MAX_FILE_SIZE_MB=15

# Default Admin Account (Seeded automatically on startup if admin does not exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456
ADMIN_NAME=Form Master Administrator

# Email SMTP Notification Configuration (Optional)
# If left blank, notifications are simulated in console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@formcraft.local
